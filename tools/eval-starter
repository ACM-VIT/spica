#!/usr/bin/env python3
"""Finite private-desktop native smoke or phase-based resource/frame evaluation."""
import argparse
import hashlib
import json
import math
import os
from pathlib import Path
import subprocess
import time
import measure_process as measure

ROOT = Path(__file__).resolve().parents[1]
COMMANDS = []


def run(*args, timeout=30):
    begin = time.monotonic()
    result = subprocess.run(args, cwd=ROOT, text=True, capture_output=True, timeout=timeout)
    COMMANDS.append(dict(argv=args, begin=begin, end=time.monotonic(), exit=result.returncode,
                         stdout=result.stdout, stderr=result.stderr))
    result.check_returncode()
    return result.stdout.strip()


def wait_windows(session, present):
    deadline = time.monotonic() + 10
    while time.monotonic() < deadline:
        windows = run('vd', 'windows', session)
        if bool(windows) == present:
            return windows
        time.sleep(0.1)
    raise RuntimeError('Timed out waiting for starter window state')


def source_fingerprint():
    digest = hashlib.sha256()
    names = run('git', 'ls-files', '--cached', '--others', '--exclude-standard', '-z')
    for name in sorted(set(names.split('\0')) - {''}):
        if not (name.startswith(('src/', 'assets/', 'build/', 'tools/'))
                or name in {'build.zig', 'build.zig.zon', 'deps.lock.json'}):
            continue
        path = ROOT / name
        digest.update(name.encode() + b'\0')
        digest.update(path.read_bytes() if path.is_file() else b'<deleted>')
        digest.update(b'\0')
    return digest.hexdigest()


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def read_export(path, deadline):
    """Native exports can be visible before their final write completes."""
    while True:
        try:
            return json.loads(path.read_text())
        except (FileNotFoundError, json.JSONDecodeError) as error:
            if time.monotonic() >= deadline:
                raise RuntimeError(f'Native export unavailable or incomplete: {path}') from error
            time.sleep(.05)


def clock_offset(native):
    mapping = native.get('clock_mapping')
    if not mapping or mapping.get('host_monotonic_ns') is None:
        raise RuntimeError('No host/native clock mapping; required phase correlation unavailable')
    if mapping['native_after_ns'] < mapping['native_before_ns']:
        raise RuntimeError('Invalid host/native clock bracket')
    return mapping['host_monotonic_ns'] - (mapping['native_before_ns'] + mapping['native_after_ns']) / 2


def cache_bounds(stats):
    if stats is None:
        raise RuntimeError('Required text cache ledger unavailable')
    bounds = dict(glyph_count=512, glyph_bytes=2097152, layout_bytes=2097152, font_bytes=4194304, face_count=12)
    if any(not 0 <= stats[key] <= limit for key, limit in bounds.items()):
        raise RuntimeError('Text cache ledger exceeds existing bounds')
    return True


def cache_tail_summary(native, phase):
    offset = clock_offset(native)
    if native['dropped']:
        raise RuntimeError('Dropped telemetry cannot establish complete cache-tail history')
    begin = max(phase['begin'], phase['end'] - 5) * 1e9
    end = phase['end'] * 1e9
    frames = [f for f in native['frames'] if f['succeeded']]
    preceding = [f for f in frames if f['present_end_ns'] + offset <= begin]
    if not preceding:
        raise RuntimeError('No cache state available at settled-tail boundary')
    # This shell mutates its text cache only in paint. Carry the last observed
    # state through idle, and validate every subsequent state in the tail.
    states = [preceding[-1]] + [f for f in frames if begin < f['present_end_ns'] + offset < end]
    for frame in states:
        cache_bounds(frame.get('text_stats'))
    return dict(phase=phase['name'], begin=begin / 1e9, end=phase['end'],
                states=len(states), last=states[-1]['text_stats'], bounds_passed=True,
                maximum={key: max(frame['text_stats'][key] for frame in states) for key in states[0]['text_stats']},
                observation='per-present ledger carried through event-driven idle; no cache mutation outside paint')


def validate_native(native):
    if native['failures'] or native['run_error'] or native['attempts'] != len(native['frames']) + native['dropped']:
        raise RuntimeError('Native failure or sample accounting mismatch')
    if any(not f['paint_begin_ns'] <= f['present_begin_ns'] <= f['present_end_ns'] for f in native['frames']):
        raise RuntimeError('Nonmonotonic frame timestamps')
    clock_offset(native)
    cache_bounds(native.get('text_stats'))
    for frame in native['frames']:
        cache_bounds(frame.get('text_stats'))


def frame_summary(native, phase):
    offset = clock_offset(native)
    mapping = native['clock_mapping']
    frames = [f for f in native['frames'] if f['succeeded'] and
              phase['begin'] * 1e9 <= f['present_end_ns'] + offset < phase['end'] * 1e9]
    work = [f['present_begin_ns'] - f['paint_begin_ns'] for f in frames]
    present = [f['present_end_ns'] - f['present_begin_ns'] for f in frames]
    total = [f['present_end_ns'] - f['paint_begin_ns'] for f in frames]
    intervals = [b['present_end_ns'] - a['present_end_ns'] for a, b in zip(frames, frames[1:])]
    complete = native['dropped'] == 0
    return dict(successful_samples=len(frames),
                achieved_fps=len(frames) / (phase['end'] - phase['begin']) if complete else None,
                sampled_fps_lower_bound=len(frames) / (phase['end'] - phase['begin']),
                successful_presents_run_total=native.get('successful_presents'),
                frame_work_ns=measure.distribution(work) if complete else None,
                present_call_ns=measure.distribution(present) if complete else None,
                total_paint_ns=measure.distribution(total) if complete else None,
                successful_return_interval_ns=measure.distribution(intervals) if complete else None,
                long_work={str(t): sum(v > t for v in work) for t in (16667000, 33333000, 50000000)} if complete else None,
                long_total={str(t): sum(v > t for v in total) for t in (16667000, 33333000, 50000000)} if complete else None,
                return_intervals_over_150ms=sum(v > 150000000 for v in intervals) if complete else None,
                full_cohort=complete, low_sample_tail_warning=len(frames) < 100,
                clock_mapping_uncertainty_ns=mapping['native_after_ns'] - mapping['native_before_ns'])


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--output', type=Path, default=ROOT / '.artifacts/starter')
    parser.add_argument('--mode', choices=('smoke', 'editor', 'measure'), default='smoke')
    parser.add_argument('--binary', type=Path, help='Explicit frozen binary; requires --binary-sha256 and --source-sha256')
    parser.add_argument('--binary-sha256')
    parser.add_argument('--source-sha256')
    parser.add_argument('--optimize', choices=('Debug', 'ReleaseSafe'), default='ReleaseSafe')
    parser.add_argument('--warmup', type=float, default=10)
    parser.add_argument('--phase-seconds', type=float, default=15)
    parser.add_argument('--cycles', type=int, default=3)
    parser.add_argument('--interval', type=float, default=.25)
    parser.add_argument('--disable-metrics', action='store_true', help='Same binary opt-in overhead comparison; frame metrics unavailable')
    args = parser.parse_args()
    if not all(math.isfinite(v) and v > 0 for v in (args.warmup, args.phase_seconds, args.interval)) or not 1 <= args.cycles <= 100:
        parser.error('finite positive durations and cycles 1..100 required')
    if args.binary and not (args.binary_sha256 and args.source_sha256):
        parser.error('frozen binary requires both fingerprints')
    output = args.output.resolve()
    output.mkdir(parents=True, exist_ok=True)
    # An old export must never satisfy this run's assertions.
    for name in ('automation.json', 'native.json'):
        if (output / name).exists():
            parser.error('output already contains native exports; choose a fresh output directory')
    source = source_fingerprint()
    binary = args.binary.resolve() if args.binary else ROOT / 'zig-out/bin/spica'
    if args.binary:
        if sha(binary) != args.binary_sha256 or source != args.source_sha256:
            raise RuntimeError('Frozen binary/source fingerprint mismatch')
    else:
        with (output / 'build.log').open('w') as log:
            subprocess.run(['python3', 'build/driver.py', '-Doptimize=' + args.optimize], cwd=ROOT,
                           stdout=log, stderr=subprocess.STDOUT, check=True, timeout=300)
    if source != source_fingerprint():
        raise RuntimeError('Source changed during build')
    manifest = dict(version=2, revision=run('git', 'rev-parse', 'HEAD'), status=run('git', 'status', '--porcelain'),
                    source_sha256=source, binary_sha256=sha(binary), binary=str(binary),
                    build_mode=args.optimize if not args.binary else 'externally frozen; see supplied binary provenance',
                    build_command=None if args.binary else ['python3', 'build/driver.py', '-Doptimize=' + args.optimize],
                    zig=run('zig', 'version'), scenario=args.mode, commands=COMMANDS, passed=False,
                    input_origin='real private vd Ctrl+Q and compositor resize, not SDL event injection',
                    limitations=['Software timing, not physical latency or scanout.', 'Paced 10Hz resize is demand, not maximum render capacity.',
                                 'GPU hardware not established by SDL renderer name.', 'Low-N p99 is weak; dropped telemetry is not a complete cohort.',
                                 'Cache ledger excludes external metadata/driver allocations; idle states carry forward only because this shell mutates cache during paint.'])
    session, samples, phases, actions = None, [], [], []
    try:
        session = run('vd', 'start', '--width', '1280', '--height', '800')
        record = json.loads((Path(session) / 'session.json').read_text())
        manifest['private_desktop'] = record
        duration = args.warmup + args.phase_seconds * (1 + 2 * args.cycles)
        argv = [str(binary), '--quit-after-ms', str(math.ceil((duration + 60) * 1000)),
                '--automation-output', str(output / 'automation.json')]
        if not args.disable_metrics:
            argv += ['--metrics-output', str(output / 'native.json')]
        launch = json.loads(run('vd', 'run', session, '--bg', '--log', str(output / 'app.log'), '--', *argv))
        manifest['launch'] = launch
        root_identity = measure.identity(measure.stat(Path('/proc') / str(launch['pid']) / 'stat'))
        manifest['root_identity'] = root_identity
        windows = wait_windows(session, True)
        if 'Spica' not in windows:
            raise RuntimeError('Wrong native window')
        manifest['windows_before'] = windows
        window_id = windows.splitlines()[0].split()[0]
        def ipc(command):
            result = json.loads(run('swaymsg', '--socket', record['environment']['SWAYSOCK'], '--raw', command))
            if not all(item.get('success') for item in result):
                raise RuntimeError(result)
        ipc(f'[con_id={window_id}] floating enable')
        ipc(f'[con_id={window_id}] resize set width 1100 px height 740 px')
        run('vd', 'shot', session, str(output / 'before.png'))
        if args.mode == 'editor':
            original = 'hello e\u0301 שלום 👩‍💻'
            editor_actions = [
                ('text', original), ('key', 'ctrl+a'), ('key', 'ctrl+c'),
                ('key', 'ctrl+x'), ('key', 'ctrl+v'), ('key', 'ctrl+z'),
                ('key', 'ctrl+shift+z'), ('key', 'End'), ('key', 'shift+Return'),
                ('text', 'second line'), ('key', 'ctrl+Home'), ('key', 'shift+Right'),
                ('key', 'BackSpace'), ('key', 'ctrl+z'), ('key', 'Escape'),
                ('key', 'Tab'), ('text', 'MUST_NOT_INSERT'), ('key', 'Tab'),
            ]
            for operation, value in editor_actions:
                begin = time.monotonic()
                run('vd', operation, session, window_id, value)
                actions.append(dict(operation=operation, value=value, begin=begin, end=time.monotonic()))
            expected_draft = original + '\nsecond line'
        if args.mode == 'measure':
            schedule = [('warmup', args.warmup), ('idle', args.phase_seconds)]
            for cycle in range(1, args.cycles + 1):
                schedule += [(f'active_{cycle}', args.phase_seconds), (f'settled_{cycle}', args.phase_seconds)]
            for name, seconds in schedule:
                begin = time.monotonic()
                end, due_sample, due_action, count = begin + seconds, begin, begin, 0
                while time.monotonic() < end:
                    now = time.monotonic()
                    if name.startswith('active') and now >= due_action:
                        w, h = (1000, 680) if count % 2 == 0 else (1100, 740)
                        action = dict(phase=name, sequence=count, due=due_action, begin=now, size=[w, h])
                        ipc(f'[con_id={window_id}] resize set width {w} px height {h} px')
                        action['end'] = time.monotonic()
                        actions.append(action)
                        count += 1
                        due_action = begin + count * .1
                    if time.monotonic() >= due_sample:
                        row = measure.sample(launch['pid'], expected_root=root_identity)
                        row.update(phase=name, scheduled_monotonic_seconds=due_sample,
                                   lateness_seconds=max(0, row['monotonic_seconds'] - due_sample))
                        samples.append(row)
                        if row['root_exited']:
                            raise RuntimeError('Native root exited/reused during phase')
                        due_sample += args.interval
                        row['missed_intervals'] = max(0, math.floor((time.monotonic() - due_sample) / args.interval))
                        due_sample += row['missed_intervals'] * args.interval
                    time.sleep(max(0, min(end, due_sample, due_action if name.startswith('active') else end) - time.monotonic()))
                phases.append(dict(name=name, begin=begin, end=time.monotonic(), requested_seconds=seconds,
                                   demanded_resize_hz=10 if name.startswith('active') else 0,
                                   requested_actions=math.ceil(seconds * 10) if name.startswith('active') else 0, delivered_actions=count))
        # Captures and export follow all resource phase boundaries.
        run('vd', 'shot', session, str(output / 'after.png'))
        run('vd', 'key', session, window_id, 'ctrl+q')
        wait_windows(session, False)
        deadline = time.monotonic() + 10
        snapshot = read_export(output / 'automation.json', deadline)
        if snapshot['close_reason'] != 'ctrl_q' or snapshot['running']:
            raise RuntimeError('Real Ctrl+Q not observed through native dispatch')
        manifest['snapshot'] = snapshot
        if args.mode == 'editor':
            if snapshot.get('draft') != expected_draft or not snapshot.get('editor_focused'):
                raise RuntimeError('Real Unicode editor input/clipboard/undo/focus round-trip failed')
            targets = {target['id']: target for target in snapshot.get('targets', [])}
            if targets.get('composer.input', {}).get('pointer_bounds') is None:
                raise RuntimeError('Painted composer target bounds unavailable')
        if not args.disable_metrics:
            native = read_export(output / 'native.json', deadline)
            validate_native(native)
            manifest['frame_phases'] = [dict(phase=p['name'], **frame_summary(native, p)) for p in phases]
            manifest['renderer'] = native['renderer']
            manifest['video'] = native['video']
            manifest['text_stats'] = native['text_stats']
            manifest['final_cache_bounds'] = cache_bounds(native['text_stats'])
            manifest['cache_tails'] = [cache_tail_summary(native, p) for p in phases if p['name'].startswith('settled')]
            manifest['metrics_status'] = 'complete' if native['dropped'] == 0 else 'incomplete_dropped_samples'
            if native['dropped']:
                raise RuntimeError('Required complete native cohort unavailable: telemetry dropped samples')
        else:
            manifest['metrics_status'] = 'unavailable_explicitly_disabled'
        manifest['resource_phases'] = [dict(phase=p['name'], **measure.summarize([s for s in samples if s['phase'] == p['name']])) for p in phases]
        tails = []
        for phase in phases:
            if phase['name'].startswith('settled'):
                rows = [s for s in samples if s['phase'] == phase['name'] and s['monotonic_seconds'] >= phase['end'] - 5]
                tails.append(dict(phase=phase['name'], **measure.summarize(rows)))
        manifest['settled_tails'] = tails
        manifest['resource_coverage'] = measure.summarize(samples)['coverage']
        manifest['settled_growth'] = {key: (tails[-1][key]['p50'] - tails[0][key]['p50']) if tails and tails[-1][key]['p50'] is not None and tails[0][key]['p50'] is not None else None for key in ('rss_bytes', 'pss_bytes')}
        if source != source_fingerprint() or manifest['binary_sha256'] != sha(binary):
            raise RuntimeError('Source/binary drift during evaluation')
        manifest['passed'] = True  # lifecycle/instrumentation only; not performance acceptance
    except BaseException as error:
        manifest['error'] = repr(error)
        raise
    finally:
        try:
            if session:
                try:
                    manifest['cleanup'] = run('vd', 'clean', session)
                    (output / 'compositor.log').write_text((Path(session) / 'compositor.log').read_text())
                except Exception as error:
                    manifest.update(passed=False, cleanup_error=repr(error))
                    raise
        finally:
            manifest['phases'] = phases
            (output / 'samples.json').write_text(json.dumps(samples, indent=2) + '\n')
            (output / 'actions.json').write_text(json.dumps(actions, indent=2) + '\n')
            (output / 'manifest.json').write_text(json.dumps(manifest, indent=2) + '\n')
    print(output / 'manifest.json')


if __name__ == '__main__':
    main()
