def fixture_events(session: Session) -> list[dict[str, Any]]:
    provider = session.data.get("provider")
    if provider not in {"codex-fixture", "codex-orchestration-fixture", "opencode-fixture"}:
        raise DriverError("fixture trace requested for a non-fixture provider", EX_PROVIDER)
    event_name = "orchestration-events.jsonl" if provider == "codex-orchestration-fixture" else "workflow-events.jsonl"
    path = session.output / f"{provider}-account/{event_name}"
    with path.open("rb") as source:
        data = source.read(128 * 1024 + 1)
    if len(data) > 128 * 1024:
        raise DriverError("offline protocol event log exceeded its bound", EX_ASSERTION)
    return [json.loads(line) for line in data.splitlines()]


def orchestration_observation(session: Session, *, parent: str | None = None) -> dict[str, Any]:
    """Use the public Host read-only observer; never inspect the database."""
    binary = session.output / "orchestration-smoke"
    if not binary.is_file():
        raise DriverError("orchestration observer binary unavailable", EX_UNAVAILABLE)
    command = [str(binary), "--observe-workspace", str(session.output / "state"), session.data["workspace"]]
    if parent:
        command = [str(binary), "--observe-tasks", str(session.output / "state"), session.data["workspace"], parent]
    result = run_command(command, timeout=30)
    try:
        value = json.loads(result.stdout)
    except json.JSONDecodeError as error:
        raise DriverError("public orchestration observation was not JSON", EX_ASSERTION) from error
    if not isinstance(value, dict):
        raise DriverError("public orchestration observation was not an object", EX_ASSERTION)
    return value


def assert_orchestration_trace(events: list[dict[str, Any]], observation: dict[str, Any], parent: dict[str, Any]) -> None:
    calls = [event for event in events if event.get("method") == "item/tool/call"]
    names = [event.get("tool") for event in calls]
    if (names[:5] != ["task_catalog", "task_delegate", "task_delegate", "task_delegate", "task_list"]
            or names.count("task_delegate") != 3 or names.count("task_result") != 2
            or names.count("task_review") != 2 or names.count("task_wait") < 2):
        raise DriverError(f"unexpected production orchestration callback trace: {names}")
    if any(names.index(result) < names.index("task_list") for result in ("task_result", "task_review")):
        raise DriverError("task.result/review preceded task.list")
    if observation.get("workspace_id") == parent.get("workspace_root") or not observation.get("workspace_id"):
        raise DriverError("worker packet used a filesystem path instead of the durable workspace UUID")
    tasks = observation.get("tasks")
    if observation.get("task_count") != 2 or not isinstance(tasks, list) or len(tasks) != 2:
        raise DriverError("public Host task.list did not expose exactly two children")
    paths = [tuple(task.get("owned_paths", [])) for task in tasks]
    flattened = [path for group in paths for path in group]
    if len(set(paths)) != 2 or len(flattened) != len(set(flattened)) or any(task.get("state") != "completed" for task in tasks):
        raise DriverError("child lifecycle or disjoint ownership observation failed")
    if any(not task.get("result_present") or task.get("review") != "accepted" for task in tasks):
        raise DriverError("task.result/task.review authority was not observed")


def assert_codex_fixture_trace(events: list[dict[str, Any]], prompts: list[str]) -> None:
    starts = [event for event in events if event.get("method") == "thread/start"]
    turns = [event for event in events if event.get("method") == "turn/start"]
    if not prompts or len(starts) != 1 or not starts[0].get("thread_id") or len(turns) != len(prompts):
        raise DriverError("Codex fixture created a fresh session or missed/duplicated a turn", EX_ASSERTION)
    for index, (turn, prompt) in enumerate(zip(turns, prompts)):
        data = prompt.encode("utf-8")
        if (not turn.get("turn_id") or turn.get("thread_id") != starts[0].get("thread_id") or turn.get("prior_turns") != index
                or turn.get("prompt_bytes") != len(data)
                or turn.get("prompt_sha256") != hashlib.sha256(data).hexdigest()):
            raise DriverError("Codex upstream session context or exact prompt bytes changed", EX_ASSERTION)
    if len({turn.get("turn_id") for turn in turns}) != len(turns):
        raise DriverError("Codex fixture reused an upstream turn identity", EX_ASSERTION)


def assert_opencode_fixture_trace(events: list[dict[str, Any]], prompts: list[str], *, require_resume: bool = False) -> None:
    turns = [event for event in events if event.get("method") == "session/prompt"]
    # ACP catalog discovery creates an unprompted session. Correlate work to
    # the actual prompted session instead of mistaking catalog IO for a turn.
    session_id = turns[0].get("session_id") if turns else None
    starts = [event for event in events if event.get("method") == "session/new" and event.get("session_id") == session_id]
    resumes = [event for event in events if event.get("method") == "session/resume" and event.get("session_id") == session_id]
    if not prompts or len(starts) != 1 or len(turns) != len(prompts) or not starts[0].get("session_id"):
        raise DriverError("OpenCode fixture created a fresh session or missed/duplicated a prompt")
    for index, (turn, prompt) in enumerate(zip(turns, prompts)):
        data = prompt.encode("utf-8")
        if (turn.get("session_id") != session_id or turn.get("prior_turns") != index
                or not turn.get("turn_id") or turn.get("prompt_bytes") != len(data)
                or turn.get("prompt_sha256") != hashlib.sha256(data).hexdigest()):
            raise DriverError("OpenCode upstream session context or exact prompt bytes changed")
    if len({turn.get("turn_id") for turn in turns}) != len(turns):
        raise DriverError("OpenCode fixture reused an upstream turn identity")
    if require_resume and not resumes:
        raise DriverError("OpenCode restart did not resume the upstream session")


