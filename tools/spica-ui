def close_app(session: Session, timeout: float, *, clean_desktop: bool = True) -> None:
    if session.data.get("launch", {}).get("attached"):
        raise DriverError("attached sessions require the owning launcher to stop them", EX_USAGE)
    try:
        session.require_live()
        focus(session)
        run_command(key_argv(session, "ctrl+q"))
        deadline = time.monotonic() + timeout
        while time.monotonic() < deadline:
            windows = run_command(["vd", "windows", session.vd_session], check=False).stdout
            if session.window not in windows.split():
                session.data["stopped_unix_ns"] = now_ns()
                session.data["stop_observation"] = redact(read_json(session.observations, time.monotonic() + 2))
                session.save()
                return
            time.sleep(.1)
        raise DriverError("native window did not close", EX_TIMEOUT)
    finally:
        if clean_desktop:
            run_command(["vd", "clean", str(session.vd_session)], check=False)


def prepare_workspace_fixture(workspace: Path) -> None:
