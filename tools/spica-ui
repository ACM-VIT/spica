def receipt(args: argparse.Namespace, session: Session | None = None) -> int:
    if session is None and args.dry_run:
        print(json.dumps({"command": "receipt", "output": str(Path(args.output).resolve()),
                          "redacted": True}, indent=2))
        return 0
    if session is None:
        session = get_session(args)
    manifest = redact(session.data)
    receipt_data = {"version": 1, "status": "passed" if manifest.get("passed") else "incomplete",
                    "provider": manifest.get("provider"), "fixture_sha256": manifest.get("fixture_sha256"),
                    "scenario": manifest.get("scenario"), "revision": manifest.get("revision"),
                    "history_fixture": manifest.get("history_fixture"),
                    "source_sha256": manifest.get("source_sha256"), "binary_sha256": manifest.get("binary_sha256"),
                    "input_method": manifest.get("input_method"), "expected_outcome": manifest.get("expected_outcome"),
                    "actions": len(manifest.get("actions", [])),
                    "evidence": {"manifest": str(session.output / "session.json"),
                                 "actions": str(session.output / "actions.json"),
                                 "offline_protocol_events": str(session.output / f"{manifest.get('provider')}-account/{'orchestration-events.jsonl' if manifest.get('provider') == 'codex-orchestration-fixture' else 'workflow-events.jsonl'}") if manifest.get("provider") in {"codex-fixture", "codex-orchestration-fixture", "opencode-fixture"} else None,
                                 "screenshots": [str(path) for path in session.output.glob("*.png")]},
                    "limitations": manifest.get("limitations", [])}
    atomic_json(session.output / "receipt.json", receipt_data)
    print(json.dumps(receipt_data, indent=2))
    return 0


def add_common(parser: argparse.ArgumentParser, *, output: bool = True) -> None:
    if output:
        parser.add_argument("--output", type=Path, default=DEFAULT_OUTPUT)
    parser.add_argument("--timeout", type=float, default=15.0)
    # Suppress the subparser default so `spica-ui --dry-run launch` keeps the
    # root flag instead of being overwritten by argparse's child default.
    parser.add_argument("--dry-run", action="store_true", default=argparse.SUPPRESS)


def parser() -> argparse.ArgumentParser:
    root = argparse.ArgumentParser(prog="spica-ui", description=__doc__)
    root.add_argument("--dry-run", action="store_true", help="print the bounded plan without desktop/build/input")
    commands = root.add_subparsers(dest="command", required=True)

    item = commands.add_parser("launch", help="launch an offline provider on a private desktop")
    item.add_argument("--private", action="store_true", help="required acknowledgement of private vd desktop")
    item.add_argument("--provider", choices=("fake", "codex-fixture", "codex-orchestration-fixture", "opencode-fixture"), default="fake")
    item.add_argument("--binary", type=Path)
    item.add_argument("--build", action="store_true", help="explicitly build before launch")
    item.add_argument("--optimize", choices=("Debug", "ReleaseSafe"), default="ReleaseSafe")
    item.add_argument("--width", type=int, default=1280)
    item.add_argument("--height", type=int, default=800)
    item.add_argument("--quit-after-ms", type=int, default=180000)
    item.add_argument("--scenario", default="manual")
    add_common(item)

    item = commands.add_parser("attach", help="attach to an already launched private desktop app")
    item.add_argument("--session", required=True)
    item.add_argument("--window", required=True)
    item.add_argument("--observations", required=True, help="live export from an app launched with --automation-session")
    add_common(item)

    item = commands.add_parser("snapshot", help="print the latest read-only observation")
    item.add_argument("--save", type=Path)
    item.add_argument("--include-content", action="store_true",
                      help="opt in to draft/transcript payloads in this snapshot only")
    add_common(item)

    item = commands.add_parser("targets", help="list semantic painted targets")
    item.add_argument("--target")
    add_common(item)

    item = commands.add_parser("click", help="click an enabled semantic painted target")
    item.add_argument("target")
    add_common(item)

    item = commands.add_parser("text", help="type text through vd into an enabled semantic target")
    item.add_argument("--target", default="composer.input")
    source = item.add_mutually_exclusive_group(required=True)
    source.add_argument("--file", type=Path)
    source.add_argument("--value")
    add_common(item)

    item = commands.add_parser("key", help="send an ordinary vd keyboard event")
    item.add_argument("value")
    add_common(item)

    item = commands.add_parser("wait", help="wait for a bounded receipt/run observation")
    item.add_argument("--command", dest="command_id")
    item.add_argument("--run")
    item.add_argument("--receipt", choices=("accepted", "rejected"))
    item.add_argument("--state")
    add_common(item)

    item = commands.add_parser("screenshot", help="capture a private-desktop screenshot")
    item.add_argument("--path", required=True)
    add_common(item)

    item = commands.add_parser("stop", help="close the app through ordinary Ctrl+Q and clean its vd session")
    add_common(item)

    item = commands.add_parser("scenario", help="run a bounded offline GUI scenario")
    item.add_argument("name", choices=("send-restart", "disabled-send", "large-send", "composer-capacity", "codex-large-send", "opencode-large-send", "codex-orchestration", "second-turn",
                                             "workspace-diff", "capability-refusal", "followup-refusal", "question-refusal", "attachment-delivery", "codex-followup-attachment",
                                             "codex-session", "codex-error", "codex-crash-open", "codex-crash-recovery", "opencode-session", "opencode-error", "thread-title", "history-deep", "history-wide"))
    item.add_argument("--provider", choices=("fake", "codex-fixture", "codex-orchestration-fixture", "opencode-fixture"), help="offline fixture; inferred from scenario")
    item.add_argument("--prompt", default="offline GUI send")
    item.add_argument("--binary", type=Path)
    item.add_argument("--build", action="store_true")
    item.add_argument("--optimize", choices=("Debug", "ReleaseSafe"), default="ReleaseSafe")
    item.add_argument("--width", type=int, default=1280)
    item.add_argument("--height", type=int, default=800)
    item.add_argument("--quit-after-ms", type=int, default=180000)
    add_common(item)

    item = commands.add_parser("receipt", help="write a redacted manifest/receipt")
    add_common(item)
    return root


def main(argv: list[str] | None = None) -> int:
    cli = parser()
    try:
        args = cli.parse_args(argv)
        timeout = getattr(args, "timeout", 15)
        if not math.isfinite(timeout) or timeout <= 0:
            raise DriverError("timeout must be positive", EX_USAGE)
        if args.command == "launch":
            return launch(args)
        if args.command == "attach":
            return attach(args)
        if args.command == "snapshot":
            return snapshot(args)
        if args.command == "targets":
            return targets(args)
        if args.command in ("click", "text"):
            return input_action(args, args.command)
        if args.command == "key":
            return key(args)
        if args.command == "wait":
            return wait_command(args)
        if args.command == "screenshot":
            return screenshot(args)
        if args.command == "stop":
            return stop(args)
        if args.command == "scenario":
            return scenario(args)
        if args.command == "receipt":
            return receipt(args)
        raise DriverError("unknown command", EX_USAGE)
    except DriverError as error:
        print(f"spica-ui: {error}", file=sys.stderr)
        return error.code
    except (OSError, json.JSONDecodeError, ValueError) as error:
        print(f"spica-ui: {error}", file=sys.stderr)
        return EX_ASSERTION


if __name__ == "__main__":
    raise SystemExit(main())
