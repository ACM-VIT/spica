def composer_ready(session: Session, timeout: float) -> dict[str, Any]:
    return wait_snapshot(session, lambda value: value.get("connected") and value.get("thread_id")
                         and any(item.get("id") == "composer.input" and item.get("enabled")
                                 for item in target_groups(value)), timeout, "composer input")


def send_turn(session: Session, prompt: str, timeout: float, *, terminal: str = "completed") -> dict[str, Any]:
    before = composer_ready(session, timeout)
    old_command, old_run = before.get("send_command_id"), before.get("run_id")
    perform_input(session, "text", "composer.input", timeout, prompt)
    wait_snapshot(session, lambda value: value.get("draft") == prompt and value.get("send_ready"),
                  timeout, "exact editable prompt")
    perform_input(session, "click", "command.send", timeout)
    current = wait_snapshot(session, lambda value: value.get("send_command_id")
                            and value.get("send_command_id") != old_command
                            and value.get("send_receipt") in {"accepted", "rejected"},
                            timeout, "new Send receipt")
    if current.get("send_receipt") == "rejected":
        raise DriverError("new Send was rejected: " + str(current.get("send_rejection", "unknown")), EX_REJECTED)
    command = current["send_command_id"]
    current = wait_snapshot(session, lambda value: value.get("send_command_id") == command
                            and value.get("send_run_id") and value.get("run_id") == value.get("send_run_id")
                            and value.get("run_id") != old_run, timeout, "new correlated run")
    run, thread = current["run_id"], before["thread_id"]
    approval_sent = False

    def completed(value: dict[str, Any]) -> bool:
        nonlocal approval_sent
        if value.get("thread_id") != thread or value.get("run_id") != run:
            raise DriverError("Send changed the captured thread/run", EX_STALE)
        if value.get("run_status") in {"failed", "unknown", "interrupted", "cancelled"} and value.get("run_status") != terminal:
            raise DriverError("correlated run failed: " + value["run_status"], EX_PROVIDER)
        if value.get("run_status") == "awaiting_approval" and not approval_sent:
            perform_input(session, "click", "approval.allow", timeout)
            approval_sent = True
        return value.get("run_status") == terminal

    current = wait_snapshot(session, completed, timeout, "correlated " + terminal + " run")
    turn = {key: current.get(key) for key in ("thread_id", "run_id", "send_command_id",
            "send_run_id", "send_session_id", "send_receipt", "selected_runtime", "selected_model", "selected_effort")}
    session.data.setdefault("turns", []).append(turn)
    session.journal("scenario.turn", before, current, correlation=turn)
    return current


def start_fake_run(session: Session, prompt: str, timeout: float) -> dict[str, Any]:
    """Start a correlated fake run and return while the run still owns the UI."""
    before = composer_ready(session, timeout)
    old_command, old_run = before.get("send_command_id"), before.get("run_id")
    perform_input(session, "text", "composer.input", timeout, prompt)
    wait_snapshot(session, lambda value: value.get("draft") == prompt and value.get("send_ready"),
                  timeout, "exact active-run prompt")
    perform_input(session, "click", "command.send", timeout)
    accepted = wait_snapshot(session, lambda value: value.get("send_command_id")
                             and value.get("send_command_id") != old_command
                             and value.get("send_receipt") == "accepted", timeout,
                             "active fake Send receipt")
    command = accepted["send_command_id"]
    active = wait_snapshot(session, lambda value: value.get("send_command_id") == command
                           and value.get("send_run_id")
                           and value.get("run_id") == value.get("send_run_id")
                           and value.get("run_id") != old_run
                           and value.get("run_status") == "awaiting_approval",
                           timeout, "active fake run")
    session.journal("scenario.run-start", before, active, input_origin="ordinary vd text and pointer",
                    command_state={"id": command, "receipt": active.get("send_receipt")},
                    run_state={"id": active.get("run_id"), "status": active.get("run_status")},
                    outcome="fake_run_active")
    return active


def state_receipt(value: dict[str, Any]) -> dict[str, Any]:
    """Keep receipt records useful without copying draft or transcript content."""
    return {"thread_id": value.get("thread_id"), "run_id": value.get("run_id"),
            "pending_command": value.get("pending_command"),
            "send_command_id": value.get("send_command_id"),
            "send_receipt": value.get("send_receipt"),
            "send_stage": value.get("send_stage"),
            "workflow_error": value.get("workflow_error"),
            "attachment_count": value.get("attachment_count"),
            "attachment_bytes": value.get("attachment_bytes"),
            "followup_count": sum(bool(item) for item in value.get("followup_ids", [])),
            "run_status": value.get("run_status")}


def assert_no_new_provider_work(before: dict[str, Any], current: dict[str, Any], label: str) -> None:
    for key in ("run_id", "send_command_id", "send_run_id", "pending_command"):
        if before.get(key) != current.get(key):
            raise DriverError(f"{label} changed {key}", EX_ASSERTION)


def assert_followup_refusal(before: dict[str, Any], current: dict[str, Any], draft: str) -> None:
    if (current.get("workflow_error") != "FollowupCapabilityUnavailable"
            or current.get("draft") != draft
            or any(current.get("followup_ids", [])) or any(current.get("followup_states", []))):
        raise DriverError("follow-up refusal lost the draft or created a queued follow-up", EX_ASSERTION)
    assert_no_new_provider_work(before, current, "follow-up refusal")


def assert_cancelled_draft(before: dict[str, Any], current: dict[str, Any], draft: str) -> None:
    if (current.get("run_id") != before.get("run_id") or current.get("run_status") != "cancelled"
            or current.get("draft") != draft or current.get("pending_command")):
        raise DriverError("F6 did not cancel the same run and preserve the draft", EX_ASSERTION)


def assert_attachment_refusal(before: dict[str, Any], current: dict[str, Any], path: str,
                              draft: str, size: int) -> None:
    if (current.get("workflow_path") != path or current.get("draft") != draft
            or current.get("attachment_count") != 1
            or current.get("attachment_bytes") != size
            or current.get("workflow_error") not in {"capability_unavailable", "attachment_unsupported"}
            or "Attachments are unavailable" not in current.get("workflow_feedback", "")):
        raise DriverError("Host attachment refusal did not retain the local file and draft", EX_ASSERTION)
    assert_no_new_provider_work(before, current, "attachment refusal")


def assert_oversized_attachment_refusal(before: dict[str, Any], current: dict[str, Any],
                                       path: str, draft: str, limit: int) -> None:
    if (current.get("workflow_path") != path or current.get("draft") != draft
            or current.get("attachment_count") != 0 or current.get("attachment_bytes") != 0
            or current.get("workflow_error") not in {"StreamTooLong", "AttachmentLimit"}
            or "too large" not in current.get("workflow_feedback", "").lower()):
        raise DriverError(f"file larger than the native {limit} byte limit was admitted", EX_ASSERTION)
    assert_no_new_provider_work(before, current, "oversized attachment refusal")


def assert_send_blocked_by_attachment(current: dict[str, Any]) -> None:
