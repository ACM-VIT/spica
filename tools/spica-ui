def read_private_clipboard(session: Session) -> str:
    # vd run returns process metadata on stdout; the command's stdout goes to
    # its explicitly selected log. Never interpret that launch receipt as data.
    path = session.output / "provider-diagnostic-clipboard.json"
    if path.exists():
        raise DriverError("clipboard capture already exists", EX_STALE)
    run_command(["vd", "run", str(session.vd_session), "--log", str(path), "--", "wl-paste", "--no-newline"], private=True)
    with path.open("rb") as source:
        data = source.read(16 * 1024 + 1)
    if len(data) > 16 * 1024:
        raise DriverError("copied Send diagnostic exceeds the capture bound", EX_ASSERTION)
    return data.decode("utf-8")


def scenario(args: argparse.Namespace) -> int:
    output = Path(args.output).resolve()
    expected_provider = ("codex-orchestration-fixture" if args.name == "codex-orchestration"
                        else "codex-fixture" if args.name in {"codex-session", "codex-error", "codex-large-send", "codex-crash-open", "codex-crash-recovery", "attachment-delivery", "codex-followup-attachment"}
                        else "opencode-fixture" if args.name in {"opencode-session", "opencode-error", "opencode-large-send"}
                        else "fake")
    args.provider = args.provider or expected_provider
    if args.provider != expected_provider:
        raise DriverError(f"{args.name} requires the offline {expected_provider} provider", EX_PROVIDER)
    if args.dry_run:
        print(json.dumps({"command": "scenario", "scenario": args.name,
                          "output": str(output), "steps": scenario_steps(args.name),
                          "provider": args.provider}, indent=2))
        return 0
    launch_args = argparse.Namespace(**vars(args))
    launch_args.scenario, launch_args.private = args.name, True
    launch(launch_args)
    session = Session.load(output)
    try:
        if args.name == "codex-session":
            scenario_codex_session(session, args)
        elif args.name == "codex-orchestration":
            scenario_codex_orchestration(session, args)
        elif args.name == "opencode-session":
            scenario_opencode_session(session, args)
        elif args.name == "thread-title":
            scenario_thread_title(session, args)
        elif args.name == "history-deep":
            scenario_history_deep(session, args)
        elif args.name == "history-wide":
            scenario_history_wide(session, args)
        elif args.name == "codex-error":
            scenario_codex_error(session, args)
        elif args.name in {"codex-crash-open", "codex-crash-recovery"}:
            scenario_codex_crash(session, args)
        elif args.name == "opencode-error":
            scenario_opencode_error(session, args)
        elif args.name == "codex-followup-attachment":
            scenario_codex_followup_attachment(session, args)
        elif args.name in {"large-send", "codex-large-send", "opencode-large-send"}:
            scenario_large_send(session, args)
        elif args.name == "composer-capacity":
            scenario_composer_capacity(session, args)
        elif args.name == "disabled-send":
            current = composer_ready(session, args.timeout)
            assert_empty_send_disabled(current)
            perform_input(session, "click", "composer.input", args.timeout)
            perform_key(session, "Return", args.timeout)
            assert_empty_send_disabled(session.snapshot(args.timeout))
            session.data["expected_outcome"] = "send_disabled"
        elif args.name in {"send-restart", "second-turn"}:
            first = send_turn(session, args.prompt, args.timeout)
            capture(session, "before-restart.png")
            reopened = restart_app(session, args)
            capture(session, "after-restart.png")
            session.data["expected_outcome"] = "send_completed_and_reopened"
            if args.name == "second-turn":
                second = send_turn(session, "second offline turn 世界", args.timeout)
                if second.get("thread_id") != first.get("thread_id") or second.get("run_id") == reopened.get("run_id"):
                    raise DriverError("second turn did not retain the thread and create a distinct run", EX_ASSERTION)
                session.data["expected_outcome"] = "same_thread_second_send_after_restart"
                session.data["limitations"].append("The deterministic fake proves GUI turn/run correlation, not upstream provider context retention.")
        elif args.name == "workspace-diff":
            composer_ready(session, args.timeout)
            perform_input(session, "click", "workspace.changes", args.timeout)
            current = wait_snapshot(session, lambda value: value.get("workspace_open")
                                    and not value.get("workspace_busy") and value.get("workspace_file_count") == 1,
                                    args.timeout, "captured checkout changed-file list")
            if current.get("workspace_root") != session.data["workspace"] or current.get("workspace_stale"):
                raise DriverError("inspection belongs to a stale or different checkout", EX_STALE)
            before = current
            perform_input(session, "click", "workspace.file.0", args.timeout)
            current = wait_snapshot(session, lambda value: not value.get("workspace_busy")
                                    and value.get("workspace_diff_bytes", 0) > 0, args.timeout, "selected-file diff")
            assert_workspace_diff(before, current, session.data["workspace"])
            session.data["expected_outcome"] = "disposable_checkout_diff_visible"
            session.journal("scenario.workspace-diff", before, current, fixture="fixture.txt",
                            workspace_revision=current.get("workspace_revision"))
        elif args.name == "capability-refusal":
            capability_refusal(session, args.timeout, ("followup.enqueue", "question.answer"))
            session.data["expected_outcome"] = "unavailable_gui_capability_refused_without_input"
        elif args.name == "question-refusal":
            capability_refusal(session, args.timeout, ("question.answer",))
            session.data["expected_outcome"] = "unavailable_gui_capability_refused_without_input"
        elif args.name == "followup-refusal":
            scenario_followup_refusal(session, args)
        elif args.name == "attachment-delivery":
            scenario_attachment_delivery(session, args)
        else:
            raise DriverError(f"unknown scenario: {args.name}", EX_USAGE)
        if args.name != "codex-orchestration":
            capture(session, "result.png")
        try:
            close_app(session, args.timeout)
        except DriverError as error:
            if args.name != "codex-orchestration" or not any(message in str(error) for message in ("Stale or unknown compositor identity", "native process is no longer alive")):
                raise
        session.data["passed"] = True
        session.save()
        atomic_json(output / "manifest.json", redact(session.data))
        receipt(args, session=session)
        return 0
    except Exception as error:
        try:
            failure_packet(session, error)
        finally:
            run_command(["vd", "clean", str(session.vd_session)], check=False)
        raise


