def assert_recovered_run(before: dict[str, Any], current: dict[str, Any], expected: str) -> None:
    if (current.get("thread_id") != before.get("thread_id") or current.get("run_id") != before.get("run_id")
            or current.get("run_status") != expected or current.get("send_ready")
            or current.get("pending_command") or "unresolved" not in (current.get("send_disabled_reason") or "").lower()):
        raise DriverError("recovered run identity/outcome or disabled Send does not preserve unresolved work", EX_ASSERTION)
    if expected not in {"unknown", "interrupted"}:
        raise DriverError("active crash recovery must not claim a known terminal outcome", EX_ASSERTION)
    cards = [(index, target) for index, target in enumerate(current.get("thread_targets", []))
             if target.get("id") == current.get("thread_id")]
    states = current.get("thread_run_states", [])
    if len(cards) != 1 or cards[0][0] >= len(states) or states[cards[0][0]] != expected:
        raise DriverError("recovered sidebar status disagrees with the unresolved run outcome", EX_ASSERTION)


def scenario_codex_crash(session: Session, args: argparse.Namespace) -> None:
    opening = args.name == "codex-crash-open"
    expected = "unknown" if opening else "interrupted"
    initial = composer_ready(session, args.timeout)
    prompt = "Offline crash recovery café 世界"
    perform_input(session, "text", "composer.input", args.timeout, prompt)
    wait_snapshot(session, lambda s: s.get("draft") == prompt and s.get("send_ready"), args.timeout, "crash-test draft")
    perform_input(session, "click", "command.send", args.timeout)
    active = wait_snapshot(session, lambda s: s.get("send_receipt") == "accepted" and s.get("run_id")
                           and s.get("run_id") == s.get("send_run_id")
                           and s.get("run_status") == ("starting" if opening else "streaming"),
                           args.timeout, "accepted active run before crash")
    deadline = time.monotonic() + args.timeout
    while True:
        events = fixture_events(session)
        ready = (any(e.get("method") == "fixture/gate" and e.get("name") == "release-open"
                     and e.get("state") == "waiting" for e in events) if opening
                 else any(e.get("method") == "turn/start" for e in events))
        if ready:
            break
        if time.monotonic() >= deadline:
            raise DriverError("offline provider did not reach the correlated crash point", EX_TIMEOUT)
        time.sleep(.02)
    capture(session, "before-crash.png")
    old_starts = [e for e in events if e.get("method") in {"thread/start", "turn/start", "thread/resume", "turn/interrupt"}]
    crashed = crash_app(session, args.timeout)
    recovered = restart_app(session, args, expected_state=expected, crashed=crashed)
    recovered = wait_snapshot(session, lambda s: not s.get("pending_command") and not s.get("send_ready")
                              and "unresolved" in (s.get("send_disabled_reason") or "").lower(),
                              args.timeout, "recovery blocks replay of unresolved work")
    assert_recovered_run(active, recovered, expected)
    draft = "Keep this recovery draft; do not retry automatically 世界"
    perform_input(session, "text", "composer.input", args.timeout, draft)
    before_enter = wait_snapshot(session, lambda s: s.get("draft") == draft, args.timeout, "recovery draft")
    perform_key(session, "Return", args.timeout)
    refused = session.snapshot(args.timeout)
    assert_recovered_run(active, refused, expected)
    assert_no_new_provider_work(before_enter, refused, "disabled recovered Send")
    if refused.get("draft") != draft:
        raise DriverError("disabled recovered Send lost the draft", EX_ASSERTION)
    capture(session, "recovered-unresolved.png")
    reopened = restart_app(session, args, expected_state=expected, directory="restart-again")
    assert_recovered_run(active, reopened, expected)
    trace = [e for e in fixture_events(session) if e.get("method") in {"thread/start", "turn/start", "thread/resume", "turn/interrupt"}]
    if trace != old_starts:
        raise DriverError("reopening unresolved work dispatched a provider action", EX_ASSERTION)

    # Change the provider fixture only; app/domain state is changed through GUI input.
    profile_path = session.output / "codex-fixture-account/workflow-profile.json"
    profile = json.loads(profile_path.read_text())
    profile["mode"] = "complete"
    atomic_json(profile_path, profile)
    perform_input(session, "click", "workspace.new_thread", args.timeout)
    wait_snapshot(session, lambda s: s.get("thread_id") != active["thread_id"] and s.get("send_ready"),
                  args.timeout, "new usable chat after unresolved run")
    completed = send_turn(session, "Separate new chat after crash", args.timeout)
    if completed.get("run_id") == active.get("run_id") or completed.get("send_session_id") == active.get("send_session_id"):
        raise DriverError("new chat reused the unresolved run/session", EX_ASSERTION)
    tail = [e for e in fixture_events(session) if e.get("method") in {"thread/start", "turn/start", "thread/resume", "turn/interrupt"}]
    if tail[:len(old_starts)] != old_starts or [e["method"] for e in tail[len(old_starts):]] != ["thread/start", "turn/start"]:
        raise DriverError("new-chat recovery replayed or resumed the old provider turn", EX_ASSERTION)
    perform_input(session, "click", active["thread_id"], args.timeout)
    old = wait_snapshot(session, lambda s: s.get("thread_id") == active["thread_id"]
                        and s.get("run_id") == active["run_id"] and s.get("run_status") == expected,
                        args.timeout, "old chat retains its unresolved outcome")
    assert_recovered_run(active, old, expected)
    session.journal("scenario.codex-crash", initial, old, old_run_id=active["run_id"],
                    recovered_state=expected, new_chat_run_id=completed["run_id"],
                    input_origin="ordinary GUI Send; pidfd SIGKILL only for explicit crash injection",
                    provider_control="offline profile changed to complete only before separate new-chat Send",
                    no_replay_across_two_reopens=True)
    session.data["expected_outcome"] = "claimed_open_unknown_no_replay_new_chat_usable" if opening else "active_turn_interrupted_no_replay_new_chat_usable"
    session.data["limitations"].append("Crash injection targets the exact disposable GUI process. Unknown/interrupted state does not prove external tools stopped; no installed-provider or physical crash acceptance.")


