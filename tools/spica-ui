#!/usr/bin/env python3
"""Drive Spica through ordinary private-desktop input and read-only observations.

The driver deliberately has no database or Host API. History scenarios seed
fresh disposable state through the public-Host fixture before launch. It resolves
semantic targets from the latest painted snapshot, translates them into compositor
coordinates, and records enough provenance to reproduce a failed action.
"""
from __future__ import annotations

import argparse
import hashlib
import math
import json
import os
from pathlib import Path
import secrets
import signal
import shlex
import shutil
import subprocess
import sys
import tempfile
import time
from typing import Any, Iterable

ROOT = Path(__file__).resolve().parents[1]
DEFAULT_OUTPUT = ROOT / ".artifacts" / "spica-ui"

# Exit values are part of the driver contract.  2 is reserved for argparse.
EX_USAGE = 2
EX_UNAVAILABLE = 10
EX_STALE = 11
EX_TARGET = 12
EX_TIMEOUT = 13
EX_REJECTED = 14
EX_PROVIDER = 15
EX_ASSERTION = 16
EX_PROCESS = 17
EX_BUILD = 18

HISTORY_CASES = {"history-deep": (2, 130), "history-wide": (160, 2)}


class DriverError(Exception):
    def __init__(self, message: str, code: int = EX_ASSERTION):
        super().__init__(message)
        self.code = code


def now_ns() -> int:
    return time.time_ns()


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as source:
        for block in iter(lambda: source.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def source_fingerprint() -> str:
    """Hash the source/build/tool inputs used by the native candidate."""
    result = subprocess.run(
        ["git", "ls-files", "--cached", "--others", "--exclude-standard", "-z"],
        cwd=ROOT, capture_output=True, check=True,
    )
    names = sorted({item for item in result.stdout.decode().split("\0") if item})
    digest = hashlib.sha256()
    for name in names:
        if not (name.startswith(("src/", "assets/", "build/", "tools/"))
                or name in {"build.zig", "build.zig.zon", "deps.lock.json"}):
            continue
        path = ROOT / name
        digest.update(name.encode() + b"\0")
        digest.update(path.read_bytes() if path.is_file() else b"<deleted>")
        digest.update(b"\0")
    return digest.hexdigest()


def atomic_json(path: Path, value: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile("w", encoding="utf-8", dir=path.parent,
                                     prefix="." + path.name + ".", delete=False) as out:
        json.dump(value, out, indent=2, ensure_ascii=False, sort_keys=True)
        out.write("\n")
        temporary = Path(out.name)
    os.replace(temporary, path)


def redact(value: Any, key: str = "") -> Any:
    """Redact account/credential material while retaining useful diagnostics."""
    sensitive = ("token", "secret", "password", "credential", "cookie", "authorization",
                 "account_directory", "api_key", "access_key")
    if any(part in key.lower() for part in sensitive):
        return "<redacted>"
    # Routine receipts and action journals carry state correlation, not user
    # content.  An explicit snapshot content opt-in is provided by the CLI.
    if key.lower() in {"draft", "transcript", "custom_render", "setup_fields"}:
        return "<omitted>"
    if isinstance(value, dict):
        return {k: redact(v, k) for k, v in value.items()}
    if isinstance(value, list):
        return [redact(v, key) for v in value]
    return value


def run_command(argv: Iterable[os.PathLike[str] | str], *, timeout: float = 30,
                check: bool = True, env: dict[str, str] | None = None,
                private: bool = False) -> subprocess.CompletedProcess[str]:
    command = [str(value) for value in argv]
    if command and command[0] == "vd":
        # The installed launcher may be a symlink. Its pointer helper lives
        # beside the real script; invoking that script preserves resource lookup.
        installed = shutil.which("vd")
        if installed:
            command[0] = str(Path(installed).resolve())
    try:
        result = subprocess.run(command, cwd=ROOT, env=env,
                                text=True, capture_output=True, timeout=timeout)
    except FileNotFoundError as error:
        raise DriverError(f"required command unavailable: {error.filename}", EX_UNAVAILABLE) from error
    except subprocess.TimeoutExpired as error:
        description = "private text delivery" if private else shlex.join(command)
        raise DriverError(f"command timed out: {description}", EX_TIMEOUT) from error
    if check and result.returncode:
        detail = "private text delivery failed; content omitted" if private else (result.stderr.strip() or result.stdout.strip())
        raise DriverError(f"command failed ({result.returncode}): {detail}", EX_PROCESS)
    return result


def read_json(path: Path, deadline: float | None = None) -> dict[str, Any]:
    while True:
        try:
            with path.open(encoding="utf-8") as source:
                value = json.load(source)
            if not isinstance(value, dict):
                raise ValueError("observation is not an object")
            return value
        except (FileNotFoundError, json.JSONDecodeError, ValueError) as error:
            if deadline is None or time.monotonic() >= deadline:
                raise DriverError(f"observation unavailable or incomplete: {path}", EX_STALE) from error
            time.sleep(0.05)


def session_file(output: Path) -> Path:
    return output / "session.json"


def process_identity(pid: int) -> dict[str, Any]:
    if not isinstance(pid, int) or pid <= 0:
        raise DriverError("native process identity is missing", EX_STALE)
    try:
        # comm can contain spaces and closing parentheses. Remaining fields
        # start with state (field 3); starttime is field 22.
        stat = Path(f"/proc/{pid}/stat").read_text()
        fields = stat[stat.rindex(")") + 2:].split()
        executable = Path(f"/proc/{pid}/exe").stat()
        if fields[0] in {"Z", "X"}:
            raise ValueError("process exited")
        return {"pid": pid, "starttime_ticks": int(fields[19]),
                "executable_device": executable.st_dev, "executable_inode": executable.st_ino}
    except (OSError, ValueError, IndexError) as error:
        raise DriverError("native process is no longer alive", EX_STALE) from error


def bind_process(session: "Session", pid: int, nonce: str | None = None) -> None:
    identity = process_identity(pid)
    try:
        arguments = Path(f"/proc/{pid}/cmdline").read_bytes().split(b"\0")
        export_path = Path(os.fsdecode(arguments[arguments.index(b"--automation-live") + 1]))
        exported_nonce = arguments[arguments.index(b"--automation-session") + 1].decode("ascii")
        if not export_path.is_absolute():
            export_path = Path(f"/proc/{pid}/cwd").resolve(strict=True) / export_path
    except (OSError, ValueError, IndexError, UnicodeDecodeError) as error:
        raise DriverError("process needs --automation-live and --automation-session for correlated attachment", EX_STALE) from error
    if (export_path.resolve() != session.observations or len(exported_nonce) != 32
            or any(byte not in "0123456789abcdefABCDEF" for byte in exported_nonce)
            or (nonce is not None and nonce != exported_nonce)):
        raise DriverError("process does not match the requested observation export/session", EX_STALE)
    if identity != process_identity(pid):
        raise DriverError("native process changed while attaching", EX_STALE)
    session.data.update({"process_identity": identity, "process_nonce": exported_nonce,
                         "binary_sha256": sha256(Path(f"/proc/{pid}/exe"))})


class Session:
    def __init__(self, output: Path, data: dict[str, Any]):
        self.output = output
        self.data = data

    @classmethod
    def load(cls, output: Path) -> "Session":
        path = session_file(output)
        if not path.is_file():
            raise DriverError(f"no spica-ui session at {output}", EX_STALE)
        data = read_json(path)
        if data.get("version") != 1 or not data.get("session_nonce"):
            raise DriverError("invalid or stale spica-ui session manifest", EX_STALE)
        return cls(output, data)

    def save(self) -> None:
        atomic_json(session_file(self.output), redact(self.data))
        atomic_json(self.output / "actions.json", redact(self.data.get("actions", [])))

    @property
    def vd_session(self) -> Path:
        return Path(self.data["private_desktop"]["session"])

    @property
    def window(self) -> str:
        return str(self.data["window"])

    @property
    def observations(self) -> Path:
        return Path(self.data["observations"])

    @property
    def sway_socket(self) -> str | None:
        return self.data.get("private_desktop", {}).get("environment", {}).get("SWAYSOCK")

    def require_live(self) -> None:
        pid = self.data.get("launch", {}).get("pid")
        identity = self.data.get("process_identity")
        if not identity or process_identity(pid) != identity:
            raise DriverError("native process lifetime differs from the recorded session", EX_STALE)
        if window_node(self).get("pid") != pid:
            raise DriverError("private window belongs to a different native process", EX_STALE)

    def snapshot(self, timeout: float = 5) -> dict[str, Any]:
        self.require_live()
        value = read_json(self.observations, time.monotonic() + timeout)
        if type(value.get("version")) is not int or value["version"] != 2:
            raise DriverError("unsupported observation schema", EX_STALE)
        if not self.data.get("process_nonce") or value.get("process_nonce") != self.data["process_nonce"]:
            raise DriverError("observation belongs to a different process session", EX_STALE)
        previous = self.data.get("last_observation")
        for key in ("generation", "frame_id", "event_sequence"):
            counter = value.get(key)
            if type(counter) is not int or counter < 0 or (previous and counter < previous.get(key, 0)):
                raise DriverError("observation counters are invalid or moved backwards", EX_STALE)
        self.data["last_observation"] = {
            "generation": value.get("generation"),
            "frame_id": value.get("frame_id"),
            "event_sequence": value.get("event_sequence"),
            "observed_unix_ns": now_ns(),
        }
        self.save()
        return value

    def journal(self, action: str, before: dict[str, Any] | None,
                after: dict[str, Any] | None, **extra: Any) -> None:
        entry = {"action": action, "begin_unix_ns": extra.pop("begin_unix_ns", now_ns()),
                 "end_unix_ns": now_ns(), "before": redact(before), "after": redact(after)}
        entry.update(redact(extra))
        self.data.setdefault("actions", []).append(entry)
        atomic_json(self.output / "actions.json", redact(self.data["actions"]))
        self.save()


def target_groups(snapshot: dict[str, Any]) -> Iterable[dict[str, Any]]:
    for name in ("targets", "thread_targets", "sidebar_targets", "scope_targets",
                 "effort_targets", "navigation_targets", "task_targets", "setup_targets", "setup_provider_targets",
                 "setup_field_targets", "workflow_targets"):
        for target in snapshot.get(name, []) or []:
            if isinstance(target, dict):
                yield target
    for name in ("setup_advanced_target", "setup_existing_target", "setup_login_target", "workflow_target"):
        target = snapshot.get(name)
        if isinstance(target, dict):
            yield target


def find_target(snapshot: dict[str, Any], identifier: str) -> dict[str, Any]:
    matches = [target for target in target_groups(snapshot) if target.get("id") == identifier]
    if not matches:
        raise DriverError(f"semantic target not painted: {identifier}", EX_TARGET)
    target = matches[0]
    if not target.get("enabled"):
        raise DriverError(f"semantic target disabled: {identifier}", EX_TARGET)
    bounds = target.get("pointer_bounds")
    if not bounds or len(bounds) != 4 or bounds[2] <= 0 or bounds[3] <= 0:
        raise DriverError(f"semantic target has no painted bounds: {identifier}", EX_TARGET)
    return target


def wait_snapshot(session: Session, predicate: Any, timeout: float, label: str) -> dict[str, Any]:
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        current = session.snapshot(min(1, max(.1, deadline - time.monotonic())))
        if predicate(current):
            return current
        time.sleep(.05)
    raise DriverError(f"timed out waiting for {label}", EX_TIMEOUT)


def window_node(session: Session) -> dict[str, Any]:
    socket = session.sway_socket
    if not socket:
        raise DriverError("private desktop has no compositor socket", EX_STALE)
    result = run_command(["swaymsg", "--socket", socket, "--raw", "-t", "get_tree"])
    tree = json.loads(result.stdout)

    def walk(node: dict[str, Any]) -> dict[str, Any] | None:
        if str(node.get("id")) == session.window:
            return node
        for child in node.get("nodes", []) + node.get("floating_nodes", []):
            found = walk(child)
            if found:
                return found
        return None
    node = walk(tree)
    if not node or not node.get("rect"):
        raise DriverError("painted window disappeared from compositor tree", EX_STALE)
    return node


def window_rect(session: Session) -> dict[str, Any]:
    return window_node(session)["rect"]


def focus(session: Session) -> None:
    socket = session.sway_socket
    if not socket:
        raise DriverError("private desktop has no compositor socket", EX_STALE)
    run_command(["swaymsg", "--socket", socket, f"[con_id={session.window}]", "focus"])


def pointer(session: Session, target: dict[str, Any]) -> tuple[int, int]:
    rect = window_rect(session)
    x, y, width, height = target["pointer_bounds"]
    return int(rect["x"] + x + width // 2), int(rect["y"] + y + height // 2)


def key_argv(session: Session, value: str) -> list[str]:
    parts = value.split("+")
    if len(parts) == 1:
        return ["vd", "key", str(session.vd_session), session.window, value]
    modifiers, key = parts[:-1], parts[-1]
    keysyms = {"ctrl": "Control_L", "shift": "Shift_L", "alt": "Alt_L", "logo": "Super_L"}
    if not key or any(modifier not in keysyms for modifier in modifiers):
        raise DriverError(f"unsupported key chord: {value}", EX_USAGE)
    command = ["vd", "run", str(session.vd_session), "--", "wtype", "-s", "150"]
    for modifier in modifiers:
        command += ["-P", keysyms[modifier]]
    command += ["-k", key]
    for modifier in reversed(modifiers):
        command += ["-p", keysyms[modifier]]
    return command


def record_manifest(output: Path, *, scenario: str, binary: Path | None,
                    build_command: list[str] | None, private: dict[str, Any] | None = None,
                    provider: str = "unknown") -> dict[str, Any]:
    revision = run_command(["git", "rev-parse", "HEAD"]).stdout.strip()
    status = run_command(["git", "status", "--porcelain"], check=True).stdout
    result: dict[str, Any] = {
        "version": 1, "scenario": scenario, "revision": revision, "status": status,
        "source_sha256": source_fingerprint(), "binary": str(binary) if binary else None,
        "binary_sha256": sha256(binary) if binary and binary.is_file() else None,
        "build_mode": "explicit build" if build_command else "prebuilt; no build requested",
        "build_command": build_command, "input_method": "ordinary vd compositor input",
        "provider": provider, "private_desktop": private, "passed": False,
        "limitations": ["No physical input-to-photon or provider-inference claim.",
                        "Snapshots are bounded read-only observations; content is not copied into routine receipts.",
                        "Process-tree memory/performance are outside this workflow driver."],
    }
    return result


def offline_provider_argv(provider: str, output: Path) -> list[str]:
    if provider == "fake":
        return ["--provider", "fake"]
    if provider == "codex-fixture":
        return ["--provider", "codex", "--runtime-executable", str(ROOT / "build/codex_workflow_fixture.py"),
                "--runtime-account-directory", str(output / "codex-fixture-account"),
                "--model-provider", "openai", "--model", "offline-workflow", "--effort", "low"]
    if provider == "codex-orchestration-fixture":
        return ["--provider", "codex", "--runtime-executable", str(ROOT / "build/codex_orchestration_fixture.py"),
                "--runtime-account-directory", str(output / "codex-orchestration-fixture-account"),
                "--model-provider", "openai", "--model", "offline-orchestration", "--effort", "low"]
    if provider == "opencode-fixture":
        return ["--provider", "opencode", "--runtime-executable", str(ROOT / "build/opencode_workflow_fixture.py"),
                "--runtime-account-directory", str(output / "opencode-fixture-account"),
                "--model-provider", "opencode", "--model", "big-pickle", "--effort", "default"]
    raise DriverError("only offline fake, Codex orchestration/workflow and OpenCode fixtures are allowed", EX_PROVIDER)


def launch(args: argparse.Namespace) -> int:
    output = Path(args.output).resolve()
    provider_argv = offline_provider_argv(args.provider, output)
    if args.dry_run:
        binary = Path(args.binary).resolve() if args.binary else ROOT / "zig-out/bin/spica"
        plan = {"command": "launch", "private": args.private, "provider": args.provider,
                "output": str(output), "binary": str(binary), "build": bool(args.build),
                "state_directory": str(output / "state"), "workspace": str(output / "workspace"),
                "argv": [str(binary), *provider_argv, "--state-directory", str(output / "state"), "--workspace", str(output / "workspace"),
                         "--automation-live", str(output / "live.json"), "--automation-output", str(output / "final.json"),
                         "--automation-session", "<fresh 32-digit process nonce>"]}
        print(json.dumps(plan, indent=2))
        return 0
    if not args.private:
        raise DriverError("launch requires --private; ordinary user desktops are never used", EX_USAGE)
    if session_file(output).exists():
        raise DriverError("output already contains a session; choose a fresh directory", EX_STALE)
    binary = Path(args.binary).resolve() if args.binary else ROOT / "zig-out/bin/spica"
    build_command = None
    if args.build:
        build_command = ["python3", "build/driver.py", f"-Doptimize={args.optimize}"]
        try:
            run_command(build_command, timeout=300)
            if args.scenario in HISTORY_CASES:
                run_command(["python3", "build/driver.py", "build-history-fixture", f"-Doptimize={args.optimize}"], timeout=300)
        except DriverError as error:
            error.code = EX_BUILD
            raise
    if not binary.is_file() or not os.access(binary, os.X_OK):
        raise DriverError(f"native binary unavailable: {binary}; pass --build explicitly", EX_UNAVAILABLE)
    output.mkdir(parents=True, exist_ok=False)
    state = output / "state"
    state.mkdir()
    workspace = output / "workspace"
    workspace.mkdir()
    history = prepare_history_fixture(binary, output, args.scenario) if args.scenario in HISTORY_CASES else None
    # Prevent Git discovery from inheriting the developer checkout surrounding
    # .artifacts. Even empty-workspace scenarios own a distinct unborn repo.
    if history is None:
        run_command(["git", "-C", workspace, "init", "--quiet"])
    if args.scenario == "workspace-diff":
        prepare_workspace_fixture(workspace)
    seeded_orchestration = None
    if args.provider == "codex-orchestration-fixture":
        observer = ROOT / "zig-out/bin/orchestration-smoke"
        # The observer is a schema-coupled native binary.  A cached binary can
        # predate the app build (for example after a domain migration), which
        # makes the public read-only check fail with UnsupportedStore.  The
        # driver is incremental, so always asking the build graph for this
        # target is cheap while guaranteeing the observer matches the source
        # revision used by the scenario.
        run_command(["python3", "build/driver.py", f"-Doptimize={args.optimize}", "build-orchestration-smoke"], timeout=300)
        seeded_orchestration = json.loads(run_command([str(observer), "--seed-workspace", str(state), str(workspace)], timeout=30).stdout)
    if args.provider in {"codex-fixture", "codex-orchestration-fixture", "opencode-fixture"}:
        account = output / f"{args.provider}-account"
        account.mkdir()
        if args.provider == "codex-orchestration-fixture":
            profile = {"format": "spica-offline-codex-orchestration-v1", "workspace": str(workspace),
                       "role": "auto", "result_review": True, "child_marker": "SPICA_CHILD_codex_OK"}
            atomic_json(account / "orchestration-profile.json", profile)
        elif args.provider == "codex-fixture":
            profile = {"format": "spica-offline-codex-workflow-v1", "workspace": str(workspace),
                       "mode": {"codex-error": "fail", "codex-crash-open": "cancel-open",
                                "codex-crash-recovery": "cancel-hang",
                                "codex-followup-attachment": "cancel-hang"}.get(args.scenario, "complete"),
                       "gate_timeout_ms": 15000}
        else:
            profile = {"format": "spica-offline-opencode-workflow-v1", "workspace": str(workspace),
                       "mode": "fail" if args.scenario == "opencode-error" else "complete",
                       "runtime_version": "2.1.4", "protocol_version": 1,
                       "model_provider": "opencode", "model": "big-pickle", "effort": "default"}
        if args.provider != "codex-orchestration-fixture":
            atomic_json(account / "workflow-profile.json", profile)
    private_path = run_command(["vd", "start", "--width", str(args.width), "--height", str(args.height)]).stdout.strip()
    private_dir = Path(private_path)
    try:
        process_nonce = secrets.token_hex(16)
        private_record = json.loads((private_dir / "session.json").read_text(encoding="utf-8"))
        argv = [str(binary), *provider_argv, "--state-directory", str(state), "--workspace", str(workspace),
                "--automation-live", str(output / "live.json"), "--automation-output", str(output / "final.json"),
                "--automation-session", process_nonce,
                "--quit-after-ms", str(args.quit_after_ms)]
        launch_result = run_command(["vd", "run", private_path, "--bg", "--log", str(output / "app.log"), "--", *argv])
        launch_info = json.loads(launch_result.stdout)
        deadline = time.monotonic() + args.timeout
        window = None
        while time.monotonic() < deadline:
            windows = run_command(["vd", "windows", private_path], check=False).stdout
            if windows.strip():
                window = windows.splitlines()[0].split()[0]
                break
            time.sleep(.1)
        if window is None:
            raise DriverError("native window did not appear", EX_PROCESS)
        manifest = record_manifest(output, scenario=args.scenario, binary=binary,
                                   build_command=build_command, private={"session": private_path, **private_record},
                                   provider=args.provider)
        if args.provider in {"codex-fixture", "codex-orchestration-fixture", "opencode-fixture"}:
            fixture_name = "codex_workflow_fixture.py" if args.provider == "codex-fixture" else "opencode_workflow_fixture.py"
            if args.provider == "codex-orchestration-fixture":
                fixture_name = "codex_orchestration_fixture.py"
            manifest["fixture_sha256"] = sha256(ROOT / "build" / fixture_name)
            runtime_name = "Codex orchestration app-server" if args.provider == "codex-orchestration-fixture" else "Codex app-server" if args.provider == "codex-fixture" else "OpenCode 2.1.4 ACP"
            manifest["limitations"].append(f"Production {runtime_name} adapter with an offline fixture; no installed provider compatibility or live inference claim.")
        manifest.update({"session_nonce": secrets.token_hex(16), "window": window,
                         "observations": str(output / "live.json"), "launch": launch_info, "workspace": str(workspace),
                         "actions": []})
        if seeded_orchestration is not None:
            manifest["orchestration_workspace_id"] = seeded_orchestration["workspace_id"]
        if history is not None:
            manifest["history_fixture"] = history
            manifest["limitations"].append("Synthetic public-Host history with fixed fake responses; no real provider or performance acceptance.")
        session = Session(output, manifest)
        bind_process(session, launch_info["pid"], process_nonce)
        session.save()
        # Require a first painted snapshot so every subsequent action has a fresh baseline.
        session.snapshot(args.timeout)
        atomic_json(output / "manifest.json", redact(manifest))
        print(json.dumps(redact({"output": str(output), "session": private_path, "window": window,
                                 "session_nonce": manifest["session_nonce"]}), indent=2))
        return 0
    except Exception:
        run_command(["vd", "clean", private_path], check=False)
        raise


def attach(args: argparse.Namespace) -> int:
    output = Path(args.output).resolve()
    if args.dry_run:
        print(json.dumps({"command": "attach", "output": str(output), "session": args.session,
                          "window": args.window, "observations": args.observations}, indent=2))
        return 0
    if session_file(output).exists():
        raise DriverError("output already contains a session", EX_STALE)
    private_path = Path(args.session).resolve()
    record_path = private_path / "session.json"
    if not record_path.is_file():
        raise DriverError("private desktop session record unavailable", EX_STALE)
    private_record = json.loads(record_path.read_text(encoding="utf-8"))
    windows = run_command(["vd", "windows", str(private_path)], check=False).stdout
    if str(args.window) not in windows.split():
        raise DriverError("requested window is not present in private desktop", EX_STALE)
    observations = Path(args.observations).resolve()
    if not observations.is_file():
        raise DriverError("observation export unavailable", EX_STALE)
    output.mkdir(parents=True, exist_ok=False)
    manifest = record_manifest(output, scenario="attached", binary=None, build_command=None,
                               private={"session": str(private_path), **private_record})
    manifest.update({"session_nonce": secrets.token_hex(16), "window": str(args.window),
                     "observations": str(observations), "launch": {"attached": True}, "actions": []})
    session = Session(output, manifest)
    node = window_node(session)
    pid = node.get("pid")
    if not isinstance(pid, int) or pid <= 0:
        raise DriverError("private window has no native process identity", EX_STALE)
    bind_process(session, pid)
    # A running binary can outlive a rebuild that unlinks its original inode.
    # The hash above comes from /proc/pid/exe, not a newer file at that path.
    try:
        binary = os.readlink(f"/proc/{pid}/exe")
    except OSError as error:
        raise DriverError("native process exited while attaching", EX_STALE) from error
    manifest.update({"launch": {"attached": True, "pid": pid}, "binary": str(binary),
                     "provider": "attached; not inferred"})
    session.save()
    session.snapshot(args.timeout)
    atomic_json(output / "manifest.json", redact(manifest))
    print(json.dumps({"output": str(output), "window": str(args.window)}, indent=2))
    return 0


def get_session(args: argparse.Namespace) -> Session:
    return Session.load(Path(args.output).resolve())


def snapshot(args: argparse.Namespace) -> int:
    if args.dry_run:
        print(json.dumps({"command": "snapshot", "output": str(Path(args.output).resolve())}, indent=2))
        return 0
    session = get_session(args)
    value = session.snapshot(args.timeout)
    target = Path(args.save).resolve() if args.save else None
    visible = value if args.include_content else redact(value)
    if target:
        atomic_json(target, visible)
    print(json.dumps(visible, indent=2, ensure_ascii=False))
    return 0


def targets(args: argparse.Namespace) -> int:
