def prepare_history_fixture(binary: Path, output: Path, name: str) -> dict[str, Any]:
    """Run the bounded producer to completion before starting any GUI process."""
    executable = binary.parent / "build-history-fixture"
    if not executable.is_file() or not os.access(executable, os.X_OK):
        raise DriverError("history fixture unavailable beside native binary; pass --build explicitly", EX_UNAVAILABLE)
    threads, turns = HISTORY_CASES[name]
    argv = [str(executable), "--state", str(output / "state"), "--workspace", str(output / "workspace"),
            "--threads", str(threads), "--turns", str(turns), "--content-bytes", "96",
            "--seed", "17", "--name", "GUI café 世界", "--git-init"]
    result = run_command(argv, timeout=180)
    if len(result.stdout.encode()) > 16 * 1024:
        raise DriverError("history fixture manifest exceeds its bound", EX_ASSERTION)
    manifest = json.loads(result.stdout)
    if (manifest.get("fixture") != "synthetic-large-history"
            or manifest.get("generated_threads") != threads or manifest.get("generated_turns") != threads * turns
            or manifest.get("generated_messages") != threads * turns * 2
            or manifest.get("completed_runs") != threads * turns or manifest.get("cancelled_runs") != 0
            or manifest.get("state_path") != str(output / "state")
            or manifest.get("workspace_path") != str(output / "workspace")
            or not manifest.get("provenance", {}).get("git_initialized")
            or not manifest.get("latest_thread_id")):
        raise DriverError("history fixture manifest does not match requested disposable history", EX_ASSERTION)
    atomic_json(output / "history-fixture.json", manifest)
    return {"manifest": manifest, "binary_sha256": sha256(executable), "argv": argv}


def history_ordinals(current: dict[str, Any]) -> list[int]:
    return [ordinal for message, ordinal in zip(current.get("transcript_message_ids", []), current.get("transcript_ordinals", []))
            if message and isinstance(ordinal, int)]


