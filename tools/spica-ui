def input_action(args: argparse.Namespace, operation: str) -> int:
    if args.dry_run:
        details: dict[str, Any] = {"command": operation, "output": str(Path(args.output).resolve()),
                                   "target": args.target}
        if operation == "text":
            details["source"] = str(Path(args.file).resolve()) if args.file else "inline"
            details["content_recorded"] = False
        print(json.dumps(details, indent=2))
        return 0
    session = get_session(args)
    file = getattr(args, "file", None)
    content = Path(file).read_text(encoding="utf-8") if file else getattr(args, "value", "")
    source = str(Path(file).resolve()) if file else "inline"
    after = perform_input(session, operation, args.target, args.timeout, content, source)
    print(json.dumps({"operation": operation, "target": args.target, "frame_id": after.get("frame_id")}, indent=2))
    return 0


def perform_input(session: Session, operation: str, identifier: str, timeout: float,
                  content: str = "", source: str = "inline") -> dict[str, Any]:
    before = session.snapshot(timeout)
    target = find_target(before, identifier)
    begin = now_ns()
    focus(session)
    x, y = pointer(session, target)
    if operation == "click":
        run_command(["vd", "click", str(session.vd_session), session.window, str(x), str(y)])
        detail = {"target": identifier, "pointer": [x, y], "input_origin": "ordinary vd pointer"}
    elif operation == "text":
        # Text input goes to the freshly resolved semantic target, even when a
        # previous action left keyboard focus in a menu or the sidebar.
        run_command(["vd", "click", str(session.vd_session), session.window, str(x), str(y)])
        digest = hashlib.sha256(content.encode()).hexdigest()
        if len(content.encode()) > 512:
            # vd text intentionally delays between characters and times out on
            # large drafts. Paste through the private compositor's clipboard.
            run_command(["vd", "run", str(session.vd_session), "--", "wl-copy", "--", content], private=True)
            run_command(key_argv(session, "ctrl+v"))
            origin = "ordinary private clipboard paste"
        else:
            run_command(["vd", "text", str(session.vd_session), session.window, content], private=True)
            origin = "ordinary vd text"
        detail = {"target": identifier, "input_origin": origin, "source": source,
                  "bytes": len(content.encode()), "sha256": digest}
    else:
        raise DriverError(f"unknown input operation: {operation}", EX_USAGE)
    after = session.snapshot(timeout)
    session.journal(operation, before, after, begin_unix_ns=begin, **detail)
    return after


def key(args: argparse.Namespace) -> int:
