def scenario_codex_orchestration(session: Session, args: argparse.Namespace) -> None:
    # Build the observer from this checkout and resolve the registered durable
    # workspace UUID through Host before composing the ordinary GUI prompt.
    observer = ROOT / "zig-out/bin/orchestration-smoke"
    shutil.copy2(observer, session.output / "orchestration-smoke")
    workspace = {"workspace_id": session.data.get("orchestration_workspace_id"),
                 "workspace_root": session.data.get("workspace")}
    workspace_id = workspace.get("workspace_id")
    if not isinstance(workspace_id, str) or not workspace_id:
        raise DriverError("Host did not expose a durable workspace UUID", EX_ASSERTION)
    account = str(session.output / "codex-orchestration-fixture-account")
    def packet(index: int, marker: str) -> dict[str, Any]:
        return {"purpose": f"offline worker {index}", "prompt": f"Reply exactly {marker}. No tools.",
                "selection": {"runtime_kind": "codex", "required_runtime_version": "0.163.0",
                               "model_provider": "openai", "model_id": "offline-orchestration", "effort": "low",
                               "account_ref": account, "workspace": {"value": workspace_id}, "capability_revision": 1},
                "owned_paths": [f"worker-{index}.txt"], "acceptance": marker,
                "result_location": f"worker-{index}.txt", "detached": False,
                "budget": {"max_requests": 2, "max_elapsed_ms": 90000, "max_tokens": 4000}}
    first, second = packet(1, "SPICA_CHILD_codex_OK"), packet(2, "SPICA_CHILD_codex_OK")
    prompt = ("coordinator delegate task.catalog; use only the application's registered task tools.\n" +
              json.dumps({"request_key": "offline-worker-one", "packet": first}, separators=(",", ":")) + "\n" +
              json.dumps({"request_key": "offline-worker-two", "packet": second}, separators=(",", ":")))
    current = send_turn(session, prompt, max(args.timeout, 45))
    capture(session, "codex-orchestration-complete.png")
    # Host's worker owns the SQLite lock while the GUI is live. Close the app
    # through ordinary Ctrl+Q, then reopen the same state read-only through the
    # public observer to inspect child lifecycle/result/review rows.
    try:
        close_app(session, max(args.timeout, 15))
    except DriverError as error:
        # The app may have already exited after its bounded quit deadline.  A
        # stale private compositor identity does not invalidate the completed
        # GUI trace; the public observer below still verifies durable state.
        if not any(message in str(error) for message in ("Stale or unknown compositor identity", "native process is no longer alive")):
            raise
    parent = orchestration_observation(session, parent=current.get("run_id"))
    events = fixture_events(session)
    assert_orchestration_trace(events, parent, {"workspace_root": session.data["workspace"]})
    session.journal("scenario.codex-orchestration", workspace, parent,
                    input_origin="ordinary GUI Send with public Host workspace UUID",
                    correlation={"parent_run_id": current.get("run_id"), "send_command_id": current.get("send_command_id"),
                                 "send_session_id": current.get("send_session_id")},
                    outcome="two_children_duplicate_key_replay_disjoint_paths_result_review_completed",
                    limitations=["task.cancel was not invoked because both children completed before cancellation was meaningful.",
                                 "Task authority was observed through public Host queries; no database reads or direct state mutation."])
    session.data["expected_outcome"] = "codex_production_adapter_two_owned_children_public_host_lifecycle_and_review"


