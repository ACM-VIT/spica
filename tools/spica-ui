def crash_app(session: Session, timeout: float) -> dict[str, Any]:
    """Kill only the exact owned GUI lifetime; provider children are not proof of stopped tools."""
    if session.data.get("launch", {}).get("attached"):
        raise DriverError("attached sessions cannot be crashed by this driver", EX_USAGE)
    if not hasattr(os, "pidfd_open") or not hasattr(signal, "pidfd_send_signal"):
        raise DriverError("crash scenarios require Linux pidfd signal support", EX_UNAVAILABLE)
    before = session.snapshot(timeout)
    identity = session.data["process_identity"]
    descriptor = os.pidfd_open(identity["pid"])
    try:
        if process_identity(identity["pid"]) != identity:
            raise DriverError("native process changed before crash injection", EX_STALE)
        signal.pidfd_send_signal(descriptor, signal.SIGKILL)
    finally:
        os.close(descriptor)
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        windows = run_command(["vd", "windows", session.vd_session], check=False).stdout
        if session.window not in windows.split():
            session.data["stopped_unix_ns"] = now_ns()
            session.journal("scenario.crash", before, before, process_identity=identity,
                            input_origin="explicit pidfd SIGKILL of owned disposable GUI process")
            return before
        time.sleep(.05)
    raise DriverError("crashed native window did not disappear", EX_TIMEOUT)


def restart_app(session: Session, args: argparse.Namespace, *, expected_state: str = "completed",
                crashed: dict[str, Any] | None = None, directory: str = "restart-process") -> dict[str, Any]:
    before = crashed if crashed is not None else session.snapshot(args.timeout)
    previous_launch = session.data["launch"]
    # Preserve the private compositor until the new process has been inspected.
    if crashed is None:
        close_app(session, args.timeout, clean_desktop=False)
    restarted_output = session.output / directory
    restarted_output.mkdir(exist_ok=False)
    live = restarted_output / "live.json"
    process_nonce = secrets.token_hex(16)
    argv = [session.data["binary"], *offline_provider_argv(session.data.get("provider", "fake"), session.output),
            "--workspace", session.data["workspace"],
            "--state-directory", str(session.output / "state"), "--automation-live", str(live),
            "--automation-output", str(restarted_output / "final.json"),
            "--automation-session", process_nonce,
            "--quit-after-ms", str(args.quit_after_ms)]
    restarted = json.loads(run_command(["vd", "run", str(session.vd_session), "--bg", "--log",
                           str(restarted_output / "app.log"), "--", *argv]).stdout)
    deadline = time.monotonic() + args.timeout
    while time.monotonic() < deadline:
        windows = run_command(["vd", "windows", str(session.vd_session)], check=False).stdout
        if windows.strip():
            session.data.update({"restart_process": restarted, "previous_launch": previous_launch,
                                 "observations": str(live), "launch": restarted,
                                 "window": windows.splitlines()[0].split()[0]})
            session.data.pop("stopped_unix_ns", None)
            session.data.pop("last_observation", None)
            bind_process(session, restarted["pid"], process_nonce)
            session.save()
            current = wait_snapshot(session, lambda value: value.get("connected")
                                    and value.get("thread_id") == before.get("thread_id")
                                    and value.get("run_id") == before.get("run_id")
                                    and value.get("run_status") == expected_state, args.timeout, "durable reopened run")
            session.journal("scenario.restart", before, current, previous_launch=previous_launch,
                            launch=restarted, expected_state=expected_state,
                            input_origin="fresh process after pidfd crash" if crashed is not None else "ordinary Ctrl+Q and fresh process")
            return current
        time.sleep(.1)
    raise DriverError("restarted native window did not appear", EX_PROCESS)


def assert_composer_capacity(before: dict[str, Any], current: dict[str, Any], draft: str) -> None:
    if (current.get("draft") != draft or current.get("draft_revision") != before.get("draft_revision")
            or current.get("notice") != "TextTooLarge"):
        raise DriverError("over-capacity paste did not preserve the original draft revision", EX_ASSERTION)
    assert_no_new_provider_work(before, current, "over-capacity paste")


def assert_empty_send_disabled(current: dict[str, Any]) -> None:
    target = next((item for item in target_groups(current) if item.get("id") == "command.send"), None)
    # send_ready describes Host/selection readiness. Empty drafts disable the
    # painted target separately and show composer guidance instead of a reason.
    if (current.get("draft") != "" or not target or target.get("enabled")
            or current.get("pending_command") or current.get("send_command_id") or current.get("run_id")):
        raise DriverError("empty composer did not retain disabled Send without command/run admission", EX_ASSERTION)


def assert_workspace_diff(before: dict[str, Any], current: dict[str, Any], workspace: str) -> None:
    # workspace_revision sequences inspection responses, not checkout bindings.
    # The inspector verifies its captured binding; the driver verifies the
    # observed project/thread/root and requires a fresh selected-file result.
    if (before.get("workspace_root") != workspace or current.get("workspace_root") != workspace
            or current.get("workspace_stale")
            or any(current.get(key) != before.get(key) for key in ("project_id", "thread_id"))):
        raise DriverError("diff inspection changed its project/thread/checkout target", EX_STALE)
    if (current.get("workspace_revision", 0) <= before.get("workspace_revision", 0)
            or current.get("workspace_busy") or current.get("workspace_diff_bytes", 0) <= 0
            or current.get("workspace_file_count") != 1):
        raise DriverError("selected-file diff is missing or belongs to an old inspection response", EX_ASSERTION)
    if current.get("run_id") or current.get("send_command_id"):
        raise DriverError("read-only inspection started provider work", EX_ASSERTION)


def capability_refusal(session: Session, timeout: float, identifiers: tuple[str, ...]) -> None:
    before = composer_ready(session, timeout)
    for identifier in identifiers:
        try:
            find_target(before, identifier)
        except DriverError as error:
            if error.code != EX_TARGET:
                raise
            # A missing UI capability is an explicit driver refusal, not evidence
            # that a provider rejected a typed request. Never substitute Send.
            session.journal("scenario.capability-refusal", before, before, target=identifier,
                            outcome="driver_refused_unavailable_target", reason=str(error), input_delivered=False)
        else:
            raise DriverError("refusal scenario requires an unavailable target: " + identifier, EX_ASSERTION)
    after = session.snapshot(timeout)
    for key in ("thread_id", "run_id", "send_command_id", "draft_revision", "pending_command"):
        if before.get(key) != after.get(key):
            raise DriverError("capability refusal changed " + key, EX_ASSERTION)
