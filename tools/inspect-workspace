#!/bin/sh
# Build once: zig build build-workspace-inspection -Doptimize=ReleaseSafe
# Usage: tools/inspect-workspace ABSOLUTE_ROOT status
#        tools/inspect-workspace ABSOLUTE_ROOT diff staged|unstaged OWNED_PATH
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
exec "$root/zig-out/bin/inspect-workspace" "$@"
